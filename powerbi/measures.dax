// =====================================================================
//  Olist E-commerce — DAX measures
//  Create a table called "_Measures" (Enter data → empty table) and add
//  each measure below to it, so all measures live in one place.
//  Display folders are suggested in [brackets].
// =====================================================================


// ---------- [01 Sales] ----------------------------------------------

Revenue =
// Item price of orders that were not canceled / unavailable (freight excluded).
// Built on fact_order_items so it reacts to Category and Seller slicers.
CALCULATE (
    SUM ( fact_order_items[price] ),
    fact_order_items[is_revenue_order] = TRUE ()
)

Freight =
CALCULATE (
    SUM ( fact_order_items[freight_value] ),
    fact_order_items[is_revenue_order] = TRUE ()
)

Freight % of Revenue =
DIVIDE ( [Freight], [Revenue] )

Orders =
CALCULATE (
    DISTINCTCOUNT ( fact_orders[order_id] ),
    fact_orders[is_revenue_order] = TRUE ()
)

Items Sold =
CALCULATE (
    COUNTROWS ( fact_order_items ),
    fact_order_items[is_revenue_order] = TRUE ()
)

Customers =
CALCULATE (
    DISTINCTCOUNT ( fact_orders[customer_unique_id] ),
    fact_orders[is_revenue_order] = TRUE ()
)

Avg Order Value =
// Average amount paid per order (includes freight).
DIVIDE (
    CALCULATE ( SUM ( fact_orders[payment_value] ), fact_orders[is_revenue_order] = TRUE () ),
    [Orders]
)

Avg Item Price =
DIVIDE ( [Revenue], [Items Sold] )

Active Sellers =
CALCULATE (
    DISTINCTCOUNT ( fact_order_items[seller_id] ),
    fact_order_items[is_revenue_order] = TRUE ()
)


// ---------- [02 Time intelligence] ----------------------------------
// Requires dim_date to be marked as Date table (Table tools → Mark as date table → date).

Revenue PY =
CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Revenue YoY % =
DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )

Revenue PM =
CALCULATE ( [Revenue], DATEADD ( dim_date[date], -1, MONTH ) )

Revenue MoM % =
DIVIDE ( [Revenue] - [Revenue PM], [Revenue PM] )

Revenue YTD =
TOTALYTD ( [Revenue], dim_date[date] )

Orders PY =
CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Orders YoY % =
DIVIDE ( [Orders] - [Orders PY], [Orders PY] )


// ---------- [03 Product] --------------------------------------------

Revenue Share % =
DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALLSELECTED ( dim_product[category] ) ) )

Category Cumulative % =
// For a Pareto chart: running share of revenue, categories sorted by revenue desc.
VAR CurrentRevenue = [Revenue]
VAR Categories =
    ADDCOLUMNS ( ALLSELECTED ( dim_product[category] ), "@rev", [Revenue] )
RETURN
    DIVIDE (
        SUMX ( FILTER ( Categories, [@rev] >= CurrentRevenue ), [@rev] ),
        SUMX ( Categories, [@rev] )
    )

Category Rank =
RANKX ( ALLSELECTED ( dim_product[category] ), [Revenue], , DESC, DENSE )


// ---------- [04 Delivery & Satisfaction] ----------------------------

Delivered Orders =
CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = TRUE () )

Late Delivery % =
// is_late is 1/0 and blank when not delivered, so the average = late rate.
AVERAGE ( fact_orders[is_late] )

On-time Delivery % =
1 - [Late Delivery %]

Avg Delivery Days =
AVERAGE ( fact_orders[delivery_days] )

Avg Promised Days =
CALCULATE ( AVERAGE ( fact_orders[estimated_days] ), fact_orders[is_delivered] = TRUE () )

Avg Review Score =
AVERAGE ( fact_orders[review_score] )

Negative Review % =
// Share of reviewed orders with 1 or 2 stars.
DIVIDE (
    CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[review_score] <= 2 ),
    CALCULATE ( COUNTROWS ( fact_orders ), NOT ISBLANK ( fact_orders[review_score] ) )
)

Avg Review (On time) =
CALCULATE ( [Avg Review Score], fact_orders[is_late] = 0 )

Avg Review (Late) =
CALCULATE ( [Avg Review Score], fact_orders[is_late] = 1 )

Review Gap (On time - Late) =
[Avg Review (On time)] - [Avg Review (Late)]


// ---------- [05 Customers] ------------------------------------------

Repeat Customer % =
DIVIDE (
    CALCULATE ( COUNTROWS ( customer_rfm ), customer_rfm[frequency] > 1 ),
    COUNTROWS ( customer_rfm )
)

RFM Customers =
COUNTROWS ( customer_rfm )

RFM Revenue =
SUM ( customer_rfm[monetary] )

RFM Customer Share % =
DIVIDE ( [RFM Customers], CALCULATE ( [RFM Customers], ALL ( customer_rfm[segment] ) ) )

RFM Revenue Share % =
DIVIDE ( [RFM Revenue], CALCULATE ( [RFM Revenue], ALL ( customer_rfm[segment] ) ) )


// ---------- [06 Dynamic titles] -------------------------------------

Title Overview =
"Revenue R$ " & FORMAT ( [Revenue] / 1e6, "#,0.00" ) & "M  |  "
    & FORMAT ( [Orders], "#,0" ) & " orders  |  YoY "
    & FORMAT ( [Revenue YoY %], "+0%;-0%" )


// =====================================================================
//  Calculated COLUMNS (add to the table named in the comment, not to _Measures)
// =====================================================================

// fact_orders → Delivery Bucket
Delivery Bucket =
SWITCH (
    TRUE (),
    ISBLANK ( fact_orders[days_late] ), BLANK (),
    fact_orders[days_late] <= -10, "1. 10+ days early",
    fact_orders[days_late] <= 0, "2. 0-9 days early",
    fact_orders[days_late] <= 3, "3. 1-3 days late",
    fact_orders[days_late] <= 7, "4. 4-7 days late",
    "5. 8+ days late"
)

// fact_orders → Weekday Order (to sort purchase_weekday Mon→Sun via "Sort by column")
Weekday Order =
SWITCH (
    fact_orders[purchase_weekday],
    "Monday", 1, "Tuesday", 2, "Wednesday", 3, "Thursday", 4,
    "Friday", 5, "Saturday", 6, "Sunday", 7
)
